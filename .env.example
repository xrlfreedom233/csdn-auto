# OpenAI 兼容的 chat/completions 服务（火山方舟 / OpenAI / DeepSeek / 通义等）
# 示例为火山方舟；换服务时 API Key 要和模型所属账号匹配，否则会返回 ModelNotOpen
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_API_KEY=
# 填写服务商控制台里的模型 ID，例如 deepseek-v4-1-flash-261017、doubao-seed-2-1-pro-260628
AI_MODEL=
AI_CONNECT_TIMEOUT=10
# 长文生成较慢，建议 180 秒；推理型模型可再调大
AI_TIMEOUT=180
# 对支持思考模式的模型（如方舟 DeepSeek/豆包）关闭思考，降低耗时和费用
AI_DISABLE_THINKING=true

# CSDN
CSDN_COOKIE=replace_with_your_cookie
CSDN_X_CA_KEY=203803574
# 推荐配置签名密钥，使程序能为每次请求生成新签名。
CSDN_X_CA_SECRET=
# 没有密钥时可临时使用浏览器抓包值联调（可能很快失效）。
CSDN_X_CA_NONCE=
CSDN_X_CA_SIGNATURE=
CSDN_ARTICLE_ID=
# 仅在文章没有动态技术标签时使用
CSDN_TAGS=MCP
CSDN_CATEGORY=

# 动态提示词
PROMPT_HISTORY_PATH=.state/prompt_history.json
PROMPT_SCENE_COUNT=1
PROMPT_TECH_MIN=2
PROMPT_TECH_MAX=3
PROMPT_RECENT_WINDOW=30

# 持久化向量 RAG：原文在 knowledge/，Chroma 索引在 .state/chroma/
RAG_ENABLED=true
RAG_BACKEND=chroma
RAG_KNOWLEDGE_DIR=knowledge
RAG_VECTOR_PATH=.state/chroma
RAG_COLLECTION=csdn_mcp_knowledge
RAG_TOP_K=4
RAG_MIN_SCORE=0.2
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_EMBEDDING_BATCH_SIZE=8

# 模力方舟 Qwen3 Embedding；Key 必须使用未泄露的新令牌
EMBEDDING_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSIONS=1024
EMBEDDING_FAILOVER_ENABLED=true
EMBEDDING_QUERY_INSTRUCTION=为中文查询检索最相关的 MCP、RAG、Embedding 和向量数据库技术文档
EMBEDDING_DOCUMENT_INSTRUCTION=
EMBEDDING_TIMEOUT=60

# 每 12 小时发布一次，适配 CSDN 每日最多 2 篇的限制
SCHEDULE_INTERVAL_HOURS=12
SCHEDULE_TIMEZONE=Asia/Shanghai
